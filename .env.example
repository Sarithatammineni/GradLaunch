[TEMPLATE]
VITE_APP_TITLE=GradLaunch

# Database (server). Defaults to a local file inside .generated/db.
# Any sqlite-compatible libsql URL works, e.g. file:./placetrack.db or a Turso URL.
DATABASE_URL=file:.generated/db/placetrack.db
DATABASE_AUTH_TOKEN=

# --- AI provider -----------------------------------------------------------
# AI_PROVIDER: "openai" | "anthropic" | "gemini" | "ollama" | "echo"
AI_PROVIDER=echo
AI_MODEL=
AI_API_KEY=

# OpenAI-compatible endpoint (used by AI_PROVIDER=openai; also usable for
# Azure OpenAI, Groq, Together, OpenRouter, local llama.cpp servers, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Gemini API bases (override only if you use a proxy)
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# With AI_PROVIDER=echo, no AI key is needed: the app produces a deterministic,
# clearly-labelled template rewrite so the workflow is testable end-to-end.

# --- Server ----------------------------------------------------------------
PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API (dev vite server included)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Job source integrations (optional) ------------------------------------
# Each integration is disabled until credentials are provided. See README.
GREENHOUSE_TOKEN=
WORKABLE_TOKEN=
REMOTIVE_ENABLED=true
